# ---------------------------------------------------------------------------
# 2ndHandGuru — copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database (docker-compose overrides this to point at the "db" service)
DATABASE_URL="postgresql://guru:guru@localhost:5432/secondhandguru?schema=public"

# Public URL of the app (used for links in emails/SMS and Daraja callbacks)
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# Escrow rules (defaults; admins can override in /admin/settings)
PLATFORM_COMMISSION_PERCENT=5
DISPATCH_WINDOW_HOURS=72
AUTO_RELEASE_DAYS=5
# Unpaid orders are cancelled after this many minutes
PENDING_PAYMENT_TIMEOUT_MINUTES=30

# Shared secret for the scheduler endpoint: POST /api/cron/escrow with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET="change-me"

# ---------------------------------------------------------------------------
# M-Pesa Daraja
#   mock       – no network calls; simulate callbacks from the order page (local dev)
#   sandbox    – https://sandbox.safaricom.co.ke
#   production – https://api.safaricom.co.ke
# ---------------------------------------------------------------------------
MPESA_MODE="mock"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
# STK Push (Lipa na M-Pesa Online). Sandbox shortcode 174379 + the sandbox passkey from the Daraja portal.
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till)
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
# B2C (payouts & refunds). Sandbox: shortcode 600xxx, initiator "testapi" and the security credential generated in the portal.
MPESA_B2C_SHORTCODE="600000"
MPESA_INITIATOR_NAME="testapi"
MPESA_SECURITY_CREDENTIAL=""
# Publicly reachable base URL for callbacks (e.g. an ngrok/cloudflared tunnel in dev). Defaults to APP_URL.
MPESA_CALLBACK_BASE_URL=""
# Appended as ?token=... to callback URLs and verified on receipt
MPESA_CALLBACK_SECRET="change-me"
# Optional comma-separated allowlist of Safaricom callback IPs (leave empty to disable)
MPESA_CALLBACK_IP_ALLOWLIST=""

# ---------------------------------------------------------------------------
# Image storage: "local" (./uploads) or "s3" (AWS S3, Cloudflare R2, MinIO, DO Spaces…)
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
# Optional CDN/public base URL for non-private objects (listing photos). ID photos & dispute evidence are always served via /api/files with auth.
S3_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Email via SMTP. If SMTP_HOST is empty, emails are logged to the console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="2ndHandGuru <no-reply@2ndhandguru.co.ke>"
# SMS: "console" (log only) or "africastalking"
SMS_PROVIDER="console"
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SENDER_ID=""

# "Ask Guru" WhatsApp button on product pages (international format, digits only)
GURU_WHATSAPP_NUMBER="254797531419"
